{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Localhost (desenvolvimento). O servidor configurado recebe as mesmas permissões em tempo de execução (allow_ipc em main.rs).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:3000/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "updater:default",
    "process:allow-restart",
    "allow-list-sources",
    "allow-set-tray-live",
    "allow-set-status",
    "allow-system-audio-start",
    "allow-system-audio-stop",
    "allow-pick-source",
    "allow-list-audio-sessions"
  ]
}
