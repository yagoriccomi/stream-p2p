{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream P2P",
  "version": "0.2.1",
  "identifier": "app.streamp2p.desktop",
  "build": { "frontendDist": "https://stream-p2p.example.com" },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "shortDescription": "Transmissão de tela P2P entre amigos",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Stream P2P",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/yagoriccomi/stream-p2p/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDMDg4NjU0MUY0RkVBNjcKUldSbjZrOGZWSVlJakRxMWtoQkpjMXFQdmVocFhGT2NrRnZjMHJGUytQWllaNExMcVJEbERINTIK",
      "windows": { "installMode": "passive" }
    }
  }
}
